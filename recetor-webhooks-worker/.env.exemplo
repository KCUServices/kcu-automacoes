# recetor-webhooks - lado de casa (puxar.py). Copia para /etc/recetor-webhooks/recetor.env, chmod 600.
# NUNCA ponhas este ficheiro num repositorio.

RECETOR_URL=https://recetor-webhooks.<a-tua-conta>.workers.dev
# o mesmo valor do segredo TOKEN_FILA do Worker
RECETOR_TOKEN=

# um par por fonte (o nome da fonte em maiusculas, - passa a _)
SEGREDO_WHOP=
DESTINO_WHOP=http://10.0.0.20:5678/webhook/webhooks-whop
# destino por omissao para fontes sem DESTINO_<FONTE>
DESTINO=

# eventos mais velhos do que isto (segundos) sao reassinados com o mesmo id antes de entregar
REASSINAR_S=240

# opcional: aviso no Discord (servico discord-aprovacoes) depois de 6 falhas seguidas
AVISO_URL=
AVISO_TOKEN=
AVISO_CANAL=alertas

PUXAR_ESTADO=/var/lib/recetor-webhooks/estado.json
