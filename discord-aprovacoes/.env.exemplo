# Discord aprovacoes - ficheiro de ambiente.
# Copia para /etc/discord-aprovacoes/discord-aprovacoes.env, chmod 600, dono = utilizador do servico.
# NUNCA ponhas este ficheiro num repositorio.

# Token do bot (Discord Developer Portal -> a tua aplicacao -> Bot -> Reset Token).
# Pode ser um bot so para isto (mais simples) ou o token de um bot que ja tens (ver README: segunda sessao).
DISCORD_BOT_TOKEN=

# IDs de utilizador do Discord que podem carregar nos botoes (Definicoes -> Avancado -> Modo de programador,
# depois botao direito no teu nome -> Copiar ID). Varios: separados por virgulas.
APROVADORES=

# Canais: nome logico -> ID do canal. Cria quantos quiseres: CANAL_<NOME>_ID.
CANAL_ALERTAS_ID=
CANAL_APROVACOES_ID=
# canais que aceitam POST /aviso (por omissao so "alertas")
AVISO_CANAIS=alertas

# Prefixo do custom_id dos botoes. So os cliques com este prefixo sao tratados aqui.
PREFIXO_BOTOES=apr

# API local: onde escuta, quem pode chamar (IPs ou redes) e o token (cabecalho X-Token, 32+ caracteres).
# Gerar o token: python3 -c "import secrets; print(secrets.token_hex(32))"  (o instalar.sh gera um sozinho)
API_ESCUTA=127.0.0.1:8790
API_ORIGENS=127.0.0.1
API_TOKEN=

# Callbacks (modo empurrar): so URLs que comecam por este prefixo. Vazio = callbacks desligados (so modo puxar).
# Exemplo para o n8n na rede de casa: http://10.0.0.20:5678/webhook/
CALLBACK_PREFIXO=
# Token enviado no cabecalho X-Token dos callbacks (vazio = o mesmo API_TOKEN)
CALLBACK_TOKEN=

# Pastas (as omissoes servem para a instalacao normal)
PASTA_DADOS=/var/lib/discord-aprovacoes
PASTA_LOGS=/var/log/discord-aprovacoes
