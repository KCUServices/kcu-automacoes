   {
    "id": "b3585013-e28f-5c8e-bfcf-27769508859e",
    "name": "Resultado da publicação",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     3960,
     -260
    ],
    "parameters": {
     "jsCode": "const p = $('Contentor pronto?').item.json;\nconst pub = $('Publicar (media_publish)').item.json;\nconst media = pub.body && pub.body.id;\nconst hora = DateTime.now().setZone('Europe/Lisbon').toFormat(\"dd/MM 'às' HH:mm\");\nif (!media) {\n  return { json: { aid: p.aid, corpo: { estado: 'pendente', fase: 'erro', cor: 'laranja',\n    nota: '⚠️ O Instagram recusou publicar: ' + JSON.stringify(pub.body || pub.error || '').slice(0, 300) +\n          '\\nConfirma no perfil que não saiu antes de tentares outra vez.',\n    botoes: [{ id: 'publicar', rotulo: 'Tentar outra vez', emoji: '🔁', estilo: 'primario' }, { id: 'nao', rotulo: 'Não publicar', emoji: '❌', estilo: 'perigo' }] } } };\n}\nconst link = ($json.body && $json.body.permalink) || 'https://www.instagram.com/';\nreturn { json: { aid: p.aid, corpo: { estado: 'concluido', fase: 'publicado', apagar_imagem: true, cor: 'verde',\n  resultado: `✅ Publicado a ${hora}: ${link}`, ligacoes: [{ rotulo: 'Ver no Instagram', url: link }],\n  contexto: { link, media_id: media } } } };\n",
     "mode": "runOnceForEachItem"
    }
   },
   {
    "id": "72cc1070-d4f8-5be7-b015-a98b795e8a63",
    "name": "Teste: não publicar",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     3520,
     -100
    ],
    "parameters": {
     "jsCode": "// Modo [teste]: o contentor foi criado (prova que o Instagram conseguiu ir buscar a imagem), mas NÃO se chama o\n// media_publish. Um contentor não publicado não aparece em lado nenhum e caduca sozinho em 24 h.\nconst p = $json;\nreturn { json: { aid: p.aid, corpo: { estado: 'concluido', fase: 'teste_contentor', apagar_imagem: true, cor: 'cinzento',\n  resultado: `🧪 Teste: o Instagram foi buscar a imagem e criou o contentor ${p.contentor}, mas NÃO foi publicado.` } } };\n",
     "mode": "runOnceForEachItem"
    }
   },
   {
    "id": "d8486e99-8906-5f5d-91dd-1899b65b91ae",
