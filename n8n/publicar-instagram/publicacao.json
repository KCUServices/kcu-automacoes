   {
    "id": "410ecec4-aaf7-5aab-b580-b87dada5ac9d",
    "name": "Agendar",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1320,
     160
    ],
    "parameters": {
     "jsCode": "const c = $json.contexto;\nif (!c.quando_iso) return { json: { aid: c.aid, corpo: { estado: 'pendente', fase: 'erro', nota: '⚠️ Esta imagem não tem hora marcada.',\n  botoes: [{ id: 'publicar', rotulo: 'Publicar agora', emoji: '✅', estilo: 'sucesso' }, { id: 'nao', rotulo: 'Não publicar', emoji: '❌', estilo: 'perigo' }] } } };\nreturn { json: { aid: c.aid, corpo: { estado: 'pendente', fase: 'agendado', cor: 'azul',\n  nota: `🕒 Agendado para ${c.quando_pt}. Publico sozinho a essa hora (até 5 min depois). Ainda podes publicar já ou cancelar.`,\n  botoes: [{ id: 'publicar', rotulo: 'Publicar já', emoji: '✅', estilo: 'sucesso' }, { id: 'nao', rotulo: 'Cancelar (não publicar)', emoji: '❌', estilo: 'perigo' }] } } };\n",
     "mode": "runOnceForEachItem"
    }
   },
   {
    "id": "80bfc593-77be-55e9-bb93-47f26af62175",
    "name": "Editar",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1320,
     300
    ],
    "parameters": {
     "jsCode": "const c = $json.contexto;\nreturn { json: { aid: c.aid, corpo: { estado: 'concluido', fase: 'editar', apagar_imagem: true, cor: 'cinzento',\n  resultado: `✏️ À espera da versão editada: muda \\`${c.base}.txt\\` (ou a imagem) na pasta e grava. Nada foi publicado.` } } };\n",
     "mode": "runOnceForEachItem"
    }
   },
   {
    "id": "7e2869b0-b717-5272-845d-3be2e56f8b4f",
    "name": "Não publicar",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1320,
     440
    ],
    "parameters": {
     "jsCode": "const c = $json.contexto;\nreturn { json: { aid: c.aid, corpo: { estado: 'concluido', fase: 'recusado', apagar_imagem: true, cor: 'vermelho',\n  resultado: '❌ Não publicado. O script da pasta move os ficheiros para recusados (na volta seguinte).' } } };\n",
     "mode": "runOnceForEachItem"
    }
   },
   {
    "id": "61dcb6f3-bcc3-54bf-96a8-d439568fe6b1",
    "name": "Preparar publicação",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1320,
     -60
    ],
    "parameters": {
     "jsCode": "const c = $json.contexto;\nif (!c || !c.aid || !c.legenda) throw new Error('aprovação sem contexto para publicar');\nreturn { json: { aid: c.aid, legenda: c.legenda, nome: c.nome, teste: c.teste === true } };\n",
     "mode": "runOnceForEachItem"
    }
   },
