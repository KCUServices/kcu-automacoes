   {
    "id": "1d3b107e-1a22-5c37-89c9-c298507c1e21",
    "name": "Contentor pronto?",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     3080,
     -140
    ],
    "parameters": {
     "jsCode": "const p = $('Pronto para criar?').item.json;\nconst criar = $('Criar contentor (ainda não publica)').item.json;\nconst s = $json;\nconst tentativa = $runIndex;   // cada volta pelo «Esperar» conta uma\nlet estado = 'erro', erro = null;\nconst id = criar.body && criar.body.id;\nif (!id) erro = 'o Instagram recusou criar a publicação: ' + JSON.stringify(criar.body || criar.error || '').slice(0, 300);\nelse {\n  const sc = s.body && s.body.status_code;\n  if (sc === 'FINISHED') estado = 'pronto';\n  else if ((sc === 'IN_PROGRESS' || !sc) && tentativa < 15) estado = 'esperar';\n  else erro = `o Instagram não processou a imagem (${sc || 'sem resposta'}): ` + JSON.stringify((s.body && s.body.status) || s.body || '').slice(0, 200);\n}\nreturn { json: { ...p, estado: p.teste && estado === 'pronto' ? 'teste' : estado, erro, contentor: id || null } };\n",
     "mode": "runOnceForEachItem"
    }
   },
