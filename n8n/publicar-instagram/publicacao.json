    ],
    "parameters": {
     "jsCode": "const b = $json.body || {};\nif (b.origem !== 'n8n-instagram' || !/^apr-ig-[a-f0-9]{12,32}$/.test(String(b.id || '')))\n  throw new Error('decisão inválida recebida no webhook: ' + JSON.stringify(b).slice(0, 200));\nreturn { json: { aid: b.id, fases: null } };\n",
     "mode": "runOnceForEachItem"
    }
