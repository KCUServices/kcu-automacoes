   {
    "id": "30d6f28d-8e7c-5b89-b1f2-125d5b977bad",
    "name": "Chegou a hora?",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     440,
     300
    ],
    "parameters": {
     "jsCode": "// Agendadas cuja hora já chegou (no máximo 3 por volta: o Instagram demora a processar).\nconst r = $input.first().json;\nconst lista = Array.isArray(r.body) ? r.body : [];\nconst agora = Date.now();\nconst prontas = lista.filter((a) => a.contexto && a.contexto.quando_iso && Date.parse(a.contexto.quando_iso) <= agora);\nreturn prontas.slice(0, 3).map((a) => ({ json: { aid: a.id, fases: ['agendado'] } }));\n"
    }
   },
   {
