   {
    "id": "24bea817-d427-5bdc-bbad-ec48ffc52f96",
    "name": "O que fazer?",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     880,
     120
    ],
    "parameters": {
     "jsCode": "// O serviço só deixa reservar uma vez: cliques repetidos e a volta das agendadas não fazem nada a dobrar.\nconst r = $json.body || {};\nconst c = r.contexto || {};\nlet acao = 'nada';\nif (r.ok && r.decisao == null) acao = r.fase === 'agendado' ? 'publicar' : 'nada';   // agendada: a hora chegou\nelse if (r.ok) acao = r.decisao;                                                     // botão carregado\nreturn { json: { acao, aid: c.aid, contexto: c } };\n",
     "mode": "runOnceForEachItem"
    }
   },
