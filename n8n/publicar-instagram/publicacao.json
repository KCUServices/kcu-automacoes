   {
    "id": "0263de2a-dcb8-50f7-897f-87caa5a3219f",
    "name": "Pronto para criar?",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1980,
     -60
    ],
    "parameters": {
     "jsCode": "// A imagem fica em privado no serviço; o Instagram vai buscá-la ao webhook público com uma chave de 15 min.\nconst p = $('Preparar publicação').item.json;\nconst q = $('Quota do Instagram').item.json;\nconst k = $json;\nlet erro = null;\nconst quota = q.statusCode === 200 && q.body && q.body.data && q.body.data[0];\nif (!quota) erro = 'não consegui ler a quota do Instagram (token caducado?): ' + JSON.stringify(q.body || q.error || '').slice(0, 200);\nelse if ((quota.quota_usage || 0) >= ((quota.config || {}).quota_total || 50)) erro = `quota de publicações das últimas 24 h esgotada (${quota.quota_usage})`;\nelse if (k.statusCode !== 200 || !k.body || !k.body.chave) erro = 'não consegui preparar a imagem no serviço: ' + JSON.stringify(k.body || k.error || '').slice(0, 200);\nreturn { json: { ...p, erro, image_url: erro ? null : 'https://n8n.example.com/webhook/publicar-imagem?c=' + encodeURIComponent(k.body.chave) } };\n",
     "mode": "runOnceForEachItem"
    }
   },
