    ],
    "parameters": {
     "jsCode": "const p = $json;\nreturn { json: { aid: p.aid, corpo: { estado: 'pendente', fase: 'erro', cor: 'laranja',\n  nota: '⚠️ Falhou antes de publicar (nada saiu no Instagram): ' + String(p.erro || 'erro desconhecido').slice(0, 600),\n  botoes: [{ id: 'publicar', rotulo: 'Tentar outra vez', emoji: '🔁', estilo: 'primario' }, { id: 'nao', rotulo: 'Não publicar', emoji: '❌', estilo: 'perigo' }] } } };\n",
     "mode": "runOnceForEachItem"
    }
   },
